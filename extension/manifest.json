{
    "manifest_version": 3,
    "name": "Reading time",
    "version": "1.0",
    "action": {
      "default_popup": "main.html",
      "default_icon": "icon.png"
    },
    "background":{"service_worker":"background/background.js"},
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["scripts/content.js"]
      }
    ],
    "permissions": ["tabs", "scripting", "activeTab","storage"],
    "host_permissions": ["<all_urls>"],
    "commands": {
      "process-content": {
        "suggested_key": {
          "default": "Alt+S"
        },
        "description": "add content directly in previous selected file"
      },
      "process-popup":{
        "suggested_key":{
          "default":"Alt+Shift+S"
        },
        "description":"add content via the popup"
      }
      
    }
  }